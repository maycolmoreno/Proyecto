# Fase 10, sección 4 — lista completa de variables de entorno (docs/fases/fase-10-devops.md).
# Copiar a .env y completar con valores reales antes de `docker compose up`.

NODE_ENV=development
PORT=4000

# Backend
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio
# Dentro de Docker (contenedor api -> contenedor postgres) se usa el hostname de red "postgres:5432"
# (ya fijado en docker-compose.yml, este valor es el que usan comandos de Prisma corridos DESDE
# el host, ej. `npx prisma migrate dev`). Si tu máquina ya tiene un PostgreSQL nativo en el puerto
# 5432, el docker-compose.yml expone el contenedor en el puerto 5433 del host para evitar el choque.
DB_POSTGRES_URL=postgresql://donaconnect:donaconnect@localhost:5433/donaconnect
MONGODB_URI=mongodb://mongo:27017/donaconnect
CORS_ORIGIN=http://localhost:5173

# IA (Fase 7 — Claude/Anthropic)
IA_API_KEY=

# Cloudinary (Fase 4, ADR-009)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Mapas (IF-006 — faltante en el SRS original, agregado en ADR-038)
MAPS_API_KEY=

# Frontend (Vite)
VITE_API_URL=http://localhost:4000/api/v1
